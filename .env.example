# ─────────────────────────────────────────────────────────────────────────────
# REBIRTH — environment configuration
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project: Supabase Dashboard → Project Settings → API.
#
#   cp .env.example .env.local
#
# NEVER commit `.env.local`. It is already git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public client key. Supabase issues these as "publishable" keys
# (`sb_publishable_...`) on newer projects, and as legacy anon JWT keys
# (`eyJhbGciOi...`) on older ones. Either works here — both are safe to expose
# to the browser because every table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# Canonical site URL. Used to build the redirect links in the password-recovery
# e-mail and in the sign-up confirmation flow. Defaults to http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server-side only — NEVER expose these to the browser ─────────────────────
# Only needed if you later add privileged server jobs (e.g. a cron that
# materialises recurring routines for every user). Left blank by default;
# the application does not require it.
# SUPABASE_SERVICE_ROLE_KEY=
